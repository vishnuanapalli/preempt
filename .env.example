# Copy to .env and fill in. .env is gitignored; this file is committed.
# Every variable the app reads belongs here with a placeholder value, so a fresh clone
# knows what it needs. Never put a real value in this file.
#
# Keep this list in sync with the environment-variable table in docs/07-RUNBOOK.md.

# APP_ENV=dev
# DATABASE_URL=postgresql://user:password@localhost:5432/app_dev
# API_KEY=replace-me
