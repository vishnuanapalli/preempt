# Copy to api/.env and fill in. That file is gitignored; this one is committed.
# Never put a real value here.
#
# Keep this list in sync with the environment-variable table in docs/07-RUNBOOK.md.

# --- Database -----------------------------------------------------------------
# Local development, matching docker-compose.yml:
#   PREEMPT_DATABASE_URL=postgresql+asyncpg://preempt:preempt_local_only@localhost:5433/preempt
#
# Production is a Neon connection string. Use the POOLED endpoint (it contains
# "-pooler"): the database scale-to-zeros after five minutes, and a direct
# connection from a cold-started service is slower to establish than a pooled one.
PREEMPT_DATABASE_URL=

# Integration tests. MUST differ from PREEMPT_DATABASE_URL — a startup assertion
# refuses to run if they match, because a test suite pointed at the demo database
# will eventually truncate it.
#   Local:      postgresql+asyncpg://preempt:preempt_local_only@localhost:5434/preempt_test
#   Production: a Neon branch, never the primary
PREEMPT_TEST_DATABASE_URL=

# --- Application --------------------------------------------------------------
# One of: local | production
PREEMPT_ENVIRONMENT=local

# Authenticates writes. Generate with: openssl rand -hex 32
# There is deliberately no default — a committed development secret is never-ship #22.
PREEMPT_API_KEY=

# --- Tuning (defaults are derived, not preferences) ---------------------------
# Ingest cadence in seconds. 1800 comes from Neon's monthly compute budget: any
# query wakes the database for a five-minute minimum, and a shorter cadence
# exhausts the month's compute before the month ends (D-002).
PREEMPT_INGEST_INTERVAL_SECONDS=1800

# Retention window and the tracked-pool cap both come from the 0.5 GB storage
# limit and a measured ~98 bytes per row.
PREEMPT_RETENTION_DAYS=90
PREEMPT_MAX_TRACKED_POOLS=500
